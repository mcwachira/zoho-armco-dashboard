# Local development uses fixtures only. Production builds reject mock mode.
VITE_DATA_MODE=mock
# Development-only mock identity; ignored by production code.
VITE_AUTH_MODE=development-mock
VITE_REFRESH_INTERVAL_MS=30000

# Server-only gateway configuration. No production configuration is changed by
# this example. Requires matching authenticated GET support on the public gateway.
DASHBOARD_UPSTREAM_BASE_URL=https://g11server.tailaff2e5.ts.net
# Dedicated dashboard read credential, never a Zoho or operator credential.
DASHBOARD_UPSTREAM_TOKEN=
# Desktop integration only: use http://127.0.0.1:3004 with a local test credential.
# HTTP loopback is rejected in production and Vercel environments.

# Dashboard-only Google OIDC. Configure in Vercel after creating an OAuth client.
DASHBOARD_AUTH_URL=
DASHBOARD_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON object mapping approved email addresses to admin, operator, or viewer.
DASHBOARD_ALLOWED_USERS=
