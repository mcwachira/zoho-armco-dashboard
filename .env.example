# Local development uses fixtures only. Production builds reject mock mode.
VITE_DATA_MODE=mock
# Development-only mock identity; ignored by production code.
VITE_AUTH_MODE=development-mock
VITE_REFRESH_INTERVAL_MS=30000

# Server-only gateway configuration. No production configuration is changed by
# this example. Existing dashboard reads and G03 receipt routes use this origin.
# Document gateway exposure/DTOs and Vercel reachability remain dependencies.
# Existing project convention: this is the gateway URL (no VITE_/NEXT_PUBLIC_ prefix).
DASHBOARD_UPSTREAM_BASE_URL=https://g11server.tailaff2e5.ts.net
# Set to the middleware's DASHBOARD_SERVICE_BEARER_TOKEN value, server-side only.
# This project reads DASHBOARD_UPSTREAM_TOKEN, not DASHBOARD_SERVICE_BEARER_TOKEN.
# Never use a Zoho or operator credential here. Leave blank for mocked local work.
DASHBOARD_UPSTREAM_TOKEN=
# Desktop integration only: use http://127.0.0.1:3004 with a local test credential.
# HTTP loopback is rejected in production and Vercel environments.

# Dashboard-only Google OIDC. Configure in Vercel after creating an OAuth client.
DASHBOARD_AUTH_URL=
DASHBOARD_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON object mapping approved email addresses to admin, operator, or viewer.
DASHBOARD_ALLOWED_USERS=

# Server-only trusted email-to-internal-user-ID record for G03 identity relay.
# JSON example: {"admin@example.test":"INTERNAL_ADMIN_ID","viewer@example.test":"INTERNAL_VIEWER_ID"}
# Replace placeholders with approved internal IDs; this map does not grant roles.
DASHBOARD_USER_IDS=
