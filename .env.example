# Local development uses fixtures only. Production builds reject mock mode.
VITE_DATA_MODE=mock
# Development-only mock identity; ignored by production code.
VITE_AUTH_MODE=development-mock
VITE_REFRESH_INTERVAL_MS=30000

# Vercel Function settings. Leave unset locally. No independent testing API has
# been verified yet; never use the existing Zoho gateway or live middleware.
DASHBOARD_DATA_MODE=unconfigured
DASHBOARD_UPSTREAM_BASE_URL=
DASHBOARD_UPSTREAM_TOKEN=

# Dashboard-only Google OIDC. Configure in Vercel after creating an OAuth client.
DASHBOARD_AUTH_URL=
DASHBOARD_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON object mapping approved email addresses to admin, operator, or viewer.
DASHBOARD_ALLOWED_USERS=
